# production (Azure VM, CPU only): copy to .env.production and fill in. DATABASE_URL, AZURE_STORAGE_CONNECTION_STRING
# and the Foundry settings (LLM_/STT_/TTS_ENDPOINT, LLM_/STT_/TTS_MODEL, OPENAI_API_KEY) come from
# `terraform output -raw azure_env`, appended before copying to the VM.
# Interviewer LLM, speech-to-text and text-to-speech all run on Microsoft Foundry (no local models on the VM).
STT_BACKEND=openai
LLM_BACKEND=azure
TTS_BACKEND=openai
TTS_INSTRUCTIONS=Speak like a calm, professional job interviewer: warm, clear and at a natural pace.
# with a fallback set, fail over quickly: a live call can't wait 15s for a first token
LLM_FIRST_TOKEN_TIMEOUT=4
# the OpenAI API as backup when Foundry is slow or down
LLM_FALLBACK_ENDPOINT=https://api.openai.com
LLM_FALLBACK_MODEL=gpt-4.1-mini
LLM_FALLBACK_API_KEY=
AGENT=assistant
PACKS_DIR=packs
SCORING_ENDPOINT=
SCORING_MODEL=
SCORING_API_KEY=
TTS_VOICE=af_heart
MAX_SESSIONS=20

CODEC_ENABLED=false
DEVICE=cpu
LOG_LEVEL=INFO
VAD_THRESHOLD=0.35

# auth (Supabase Auth) + file storage (Azure Blob, private container)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BACKEND=azure
STORAGE_BUCKET=interview-coach
PUBLIC_BASE_URL=https://api.interview.voicewire.tech
SITE_URL=https://interview.voicewire.tech
CORS_ORIGINS=["https://interview.voicewire.tech"]

# payments (Paddle live account, live price ids)
PAYMENT_PROVIDER=paddle
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREDITS_5=
PADDLE_PRICE_PASS_30=
