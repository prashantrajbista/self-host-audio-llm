# production (Azure VM, CPU only): copy to .env.production on the server; docker-compose.prod.yml loads it
STT_BACKEND=remote
LLM_BACKEND=openai
TTS_BACKEND=remote

# stt/tts run as separate containers on the compose network
STT_ENDPOINT=http://stt:8001
LLM_ENDPOINT=https://api.openai.com
TTS_ENDPOINT=http://tts:8002

LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_FIRST_TOKEN_TIMEOUT=15
LLM_FALLBACK_ENDPOINT=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
AGENT=assistant
PACKS_DIR=packs
# Azure Database for PostgreSQL Flexible Server; ssl=require is mandatory there
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<server>.postgres.database.azure.com:5432/app?ssl=require
SCORING_ENDPOINT=
SCORING_MODEL=
SCORING_API_KEY=
# CPU only: large Whisper models are too slow for live calls (full 30s encoder pass per utterance)
WHISPER_MODEL=small.en
TTS_VOICE=af_heart
TTS_SPEED=1.15

# 4 vCPU VM: STT and TTS share the cores
STT_WORKERS=2
STT_CPU_THREADS=0
TTS_WORKERS=2
MAX_SESSIONS=20

CODEC_ENABLED=false
DEVICE=cpu
LOG_LEVEL=INFO
VAD_THRESHOLD=0.35

# auth (Supabase Auth) + file storage (Azure Blob, private container)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BACKEND=azure
STORAGE_BUCKET=interview-coach
AZURE_STORAGE_CONNECTION_STRING=
# fixed across restarts/replicas: `openssl rand -hex 32`
FILES_SECRET=
PUBLIC_BASE_URL=https://api.interview.voicewire.tech
SITE_URL=https://interview.voicewire.tech
CORS_ORIGINS=["https://interview.voicewire.tech"]

# payments (Paddle live account, live price ids)
PAYMENT_PROVIDER=paddle
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREDITS_5=
PADDLE_PRICE_PASS_30=
