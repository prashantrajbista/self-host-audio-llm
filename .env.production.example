# production (Azure VM, CPU only): copy to .env.production and fill in. DATABASE_URL, AZURE_STORAGE_CONNECTION_STRING
# and the Foundry settings (LLM_/STT_/TTS_ENDPOINT, LLM_/STT_/TTS_MODEL, OPENAI_API_KEY) come from
# `terraform output -raw azure_env`, appended before copying to the VM.
# Interviewer LLM, speech-to-text and text-to-speech all run on Microsoft Foundry (no local models on the VM).
STT_BACKEND=openai
LLM_BACKEND=azure
TTS_BACKEND=openai
TTS_INSTRUCTIONS=Speak like a calm, professional job interviewer: warm, clear and at a natural pace.
# with a fallback set, fail over quickly: a live call can't wait 15s for a first token
LLM_FIRST_TOKEN_TIMEOUT=4
# the OpenAI API as backup when Foundry is slow or down
LLM_FALLBACK_ENDPOINT=https://api.openai.com
LLM_FALLBACK_MODEL=gpt-4.1-mini
LLM_FALLBACK_API_KEY=
AGENT=assistant
PACKS_DIR=packs
SCORING_ENDPOINT=
SCORING_MODEL=
SCORING_API_KEY=
TTS_VOICE=af_heart
MAX_SESSIONS=20

CODEC_ENABLED=false
DEVICE=cpu
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring (README "Monitoring"). Each part is off while its values are empty.
ENVIRONMENT=production
# optional: also send traces + metrics to any OpenTelemetry (OTLP/HTTP) backend
OTEL_ENDPOINT=
OTEL_HEADERS=
# LLM tracing: Langfuse project > Settings > API keys
# https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=true
SENTRY_DSN=
# Slack incoming webhooks: activity (purchases, sign-ups, contact, refunds) and alerts (critical, pings the channel)
NOTIFY_BACKENDS=["slack"]
SLACK_WEBHOOK_URL=
SLACK_ALERTS_WEBHOOK_URL=
VAD_THRESHOLD=0.35

# auth (Supabase Auth) + file storage (Azure Blob, private container)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BACKEND=azure
STORAGE_BUCKET=interview-coach
PUBLIC_BASE_URL=https://api.interview.voicewire.tech
SITE_URL=https://interview.voicewire.tech
CORS_ORIGINS=["https://interview.voicewire.tech"]

# false (default): interviews are free and unlimited for everyone, buying is off.
# true: 2 free mocks, then credits or a pass. Keep in step with NEXT_PUBLIC_PAYMENTS_ENABLED in client/.env.*
PAYMENTS_ENABLED=false
# payments (Paddle live account, live price ids)
PAYMENT_PROVIDER=paddle
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREDITS_5=
PADDLE_PRICE_PASS_30=
