# development: copy to .env.local (loaded by default; ENV_FILE picks another file)
# faster_whisper (local) | remote (stt container) | openai (OpenAI or Azure Foundry, see STT_MODEL)
STT_BACKEND=faster_whisper
LLM_BACKEND=openai
# kokoro (local) | remote (tts container) | openai (OpenAI or Azure Foundry, see TTS_MODEL)
TTS_BACKEND=kokoro

STT_ENDPOINT=http://localhost:8001
LLM_ENDPOINT=https://api.openai.com
TTS_ENDPOINT=http://localhost:8002

LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# STT_BACKEND/TTS_BACKEND=openai. Azure Foundry: endpoints https://<resource>.openai.azure.com/openai, models =
# deployment names, OPENAI_API_KEY = the Foundry key (terraform output -raw azure_env)
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
# LLM_BACKEND=ollama, LLM_ENDPOINT=http://localhost:11434, LLM_MODEL=llama3.2   # self-hosted alt
# LLM_BACKEND=vllm, LLM_ENDPOINT=http://localhost:8000, LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # self-hosted alt (docker-compose.gpu.yml)
# all backends use the OpenAI-compatible /v1/chat/completions API; LLM_BACKEND is the primary's label
# seconds before retry/failover; ~2-3 when a fallback is set
LLM_FIRST_TOKEN_TIMEOUT=15
# optional fallback LLM (e.g. self-hosted primary -> OpenAI fallback, or the reverse); empty = disabled
LLM_FALLBACK_ENDPOINT=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
# fast-TTFT OpenAI-compatible hosts work as primary or fallback, e.g.
#   Groq:     LLM_FALLBACK_ENDPOINT=https://api.groq.com/openai   (model e.g. llama-3.1-8b-instant)
#   Cerebras: LLM_FALLBACK_ENDPOINT=https://api.cerebras.ai
# OpenAI only caches prompt prefixes >=1024 tokens (our system prompt is shorter); vLLM's prefix cache has no minimum.
# assistant | demo_tools (server/agent/agents.py); per session: ws://.../ws?agent=demo_tools
AGENT=assistant
PACKS_DIR=packs
DATABASE_URL=sqlite+aiosqlite:///data/app.db
# interview grading: use a strong model; empty = reuse LLM_ENDPOINT/LLM_MODEL/OPENAI_API_KEY
SCORING_ENDPOINT=
SCORING_MODEL=
SCORING_API_KEY=
# smallest models to save local resources; production uses small.en (see .env.production.example)
WHISPER_MODEL=tiny.en
TTS_VOICE=af_heart
TTS_SPEED=1.15

# parallelism of the shared models (see server/config.py)
STT_WORKERS=1
STT_CPU_THREADS=0
TTS_WORKERS=1
MAX_SESSIONS=5

CODEC_ENABLED=false
DEVICE=mps
LOG_LEVEL=INFO
LOG_FORMAT=text
# Monitoring: all off while empty (see .env.production.example for the full list)
OTEL_ENDPOINT=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
SLACK_WEBHOOK_URL=
SLACK_ALERTS_WEBHOOK_URL=
VAD_THRESHOLD=0.35

# auth (Supabase Auth) + file storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BACKEND=local
STORAGE_BUCKET=interview-coach
PUBLIC_BASE_URL=http://localhost:8000
SITE_URL=http://localhost:3000

# --- optional: payments (off by default) ---
# false: interviews are free and unlimited for everyone, buying is off.
# true: 2 free mocks, then credits or a pass. Keep in step with NEXT_PUBLIC_PAYMENTS_ENABLED in client/.env.*
PAYMENTS_ENABLED=false
# payments (Paddle sandbox account, test price ids)
PAYMENT_PROVIDER=paddle
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREDITS_5=
PADDLE_PRICE_PASS_30=
