STT_BACKEND=faster_whisper
LLM_BACKEND=ollama
TTS_BACKEND=kokoro

STT_ENDPOINT=http://localhost:8001
LLM_ENDPOINT=http://localhost:11434
TTS_ENDPOINT=http://localhost:8002

LLM_MODEL=llama3.2
# VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # used by docker-compose.gpu.yml instead of LLM_MODEL
WHISPER_MODEL=base.en
TTS_VOICE=af_heart

CODEC_ENABLED=false
DEVICE=mps
LOG_LEVEL=DEBUG
VAD_AGGRESSIVENESS=3
