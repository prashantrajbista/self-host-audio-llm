STT_BACKEND=faster_whisper
LLM_BACKEND=openai
TTS_BACKEND=kokoro

STT_ENDPOINT=http://localhost:8001
LLM_ENDPOINT=https://api.openai.com
TTS_ENDPOINT=http://localhost:8002

LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# LLM_BACKEND=ollama, LLM_ENDPOINT=http://localhost:11434, LLM_MODEL=llama3.2   # self-hosted alt
# LLM_BACKEND=vllm, LLM_ENDPOINT=http://localhost:8000, LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct   # self-hosted alt (docker-compose.gpu.yml)
# all backends use the OpenAI-compatible /v1/chat/completions API; LLM_BACKEND is the primary's label
# seconds before retry/failover; ~2-3 when a fallback is set
LLM_FIRST_TOKEN_TIMEOUT=15
# optional fallback LLM (e.g. self-hosted primary -> OpenAI fallback, or the reverse); empty = disabled
LLM_FALLBACK_ENDPOINT=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
# assistant | demo_tools (server/agent/agents.py); per session: ws://.../ws?agent=demo_tools
AGENT=assistant
WHISPER_MODEL=small.en
TTS_VOICE=af_heart
TTS_SPEED=1.15

CODEC_ENABLED=false
DEVICE=mps
LOG_LEVEL=INFO
VAD_THRESHOLD=0.35
