# development values: copy to client/.env.local (next dev reads it)
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# public URL of this site (share links, link-preview images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# how the Next server reaches the gateway for public share pages/images (server-side, not exposed)
GATEWAY_HTTP_URL=http://localhost:8000
# who runs this instance, shown on the privacy and terms pages
NEXT_PUBLIC_OPERATOR=
NEXT_PUBLIC_JURISDICTION=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SENTRY_DSN=
# --- optional: payments (off by default) ---
# true: show prices and plans (rebuild after changing). Must match PAYMENTS_ENABLED in the server's .env
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Paddle checkout (client-side token is safe to expose); sandbox | production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_ENV=sandbox
