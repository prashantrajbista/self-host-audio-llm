# production build values: copy to client/.env.production on the server (next build reads it; NEXT_PUBLIC_* are baked in)
NEXT_PUBLIC_GATEWAY_WS_URL=wss://api.interview.voicewire.tech/ws
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://interview.voicewire.tech
# server-side, runtime: the gateway over the compose network
GATEWAY_HTTP_URL=http://gateway:8000
# true: show prices and plans (rebuild after changing). Must match PAYMENTS_ENABLED in the server's .env
NEXT_PUBLIC_PAYMENTS_ENABLED=false
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_...
NEXT_PUBLIC_PADDLE_ENV=production
# error reports (Sentry, or GlitchTip with the same DSN format); empty = off
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=production
# cookieless page analytics (Cloudflare Web Analytics site token); empty = off
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
